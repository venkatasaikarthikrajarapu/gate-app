# Database connection (PostgreSQL 16 default, SQLite fallback supported via ADR-002)
DATABASE_URL="postgresql://gateuser:gatepass@localhost:5432/gatedb?schema=public"
# Alternative SQLite for zero-infra local dev/tests:
# DATABASE_URL="file:./dev.db"

# Session & Security
SESSION_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
APP_PASSWORD_HASH="" # Optional bcrypt hash, or configured via /setup first-run

# Optional AI Assistant layer (Tier-2 processing - default OFF)
OPTIONAL_AI_EXTRACTION_ENABLED=false
ANTIGRAVITY_LLM_ENABLED=false
ANTIGRAVITY_LLM_KEY=""
ANTIGRAVITY_LLM_MODEL=""

# Port & Environment
PORT=3000
NODE_ENV=development
